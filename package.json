{
  "name": "alkhair-islamic-finance-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Al Khair Islamic Finance website (React + Vite) with an Express API for the loan application form",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
