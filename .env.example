# Google Ads / Analytics tag id used in index.html (leave empty to disable)
VITE_GTAG_ID=

# Port for the Express API (server/index.js)
PORT=5001

# Extra hosts the Vite dev server will accept (comma-separated).
# A leading dot allows every subdomain. Use "true" to allow any host.
ALLOWED_HOSTS=.ngrok-free.dev
